//****************************************************************************
// Player bot archetypes
//
// Server-driven player characters are created from these CHARDEFs (see
// archetypes.txt for which ones and how often). ON=@Create dresses and skills
// the character exactly like a pack NPC; afterwards the engine turns it into a
// player character. Item defnames are the pack's own - edit freely, an item the
// running pack does not define is simply skipped.
//
// T2A-era kit only: plain cloth, leather/chain/plate, classic weapons.
//****************************************************************************

//----------------------------------------------------------------------------
// Warrior
//----------------------------------------------------------------------------
[CHARDEF c_playerbot_warrior_m]
ID=c_man
NAME=#NAMES_HUMANMALE
CAN=MT_EQUIP|MT_USEHANDS|MT_WALK|MT_RUN|MT_MALE
CATEGORY=Player Bots
DESCRIPTION=Warrior (male)
ON=@Create
   COLOR=colors_skin
   STR={80 100}
   DEX={70 90}
   INT={25 40}
   SWORDSMANSHIP={70.0 100.0}
   MACEFIGHTING={40.0 80.0}
   TACTICS={70.0 100.0}
   PARRYING={50.0 90.0}
   ANATOMY={60.0 100.0}
   HEALING={60.0 100.0}
   MAGICRESISTANCE={40.0 80.0}
   ITEMNEWBIE={ i_hair_short 3 i_hair_long 2 i_hair_ponytail 2 i_hair_receding 1 i_hair_pageboy 1 }
   COLOR=colors_hair
   ITEMNEWBIE={ i_beard_short 2 i_goatee 2 i_mustache 2 i_beard_long 1 }
   COLOR=match_hair
   ITEM={ i_chainmail_tunic 2 i_ringmail_tunic 2 i_platemail_chest 1 }
   ITEM=i_leather_leggings
   ITEM=i_leather_gloves
   ITEM={ i_shoes_plain 3 i_boots_thigh 2 i_sandals 2 }
   ITEM={ i_halberd 3 i_katana 3 i_mace 2 i_staff_quarter 1 }
   ITEM=i_bandage,{20 60}
   ITEM=i_potion_heal,{1 4}
   ITEM=i_potion_cure,{1 3}
   ITEM=i_gold,{80 600}

[CHARDEF c_playerbot_warrior_f]
ID=c_woman
NAME=#NAMES_HUMANFEMALE
CAN=MT_EQUIP|MT_USEHANDS|MT_WALK|MT_RUN|MT_FEMALE
CATEGORY=Player Bots
DESCRIPTION=Warrior (female)
ON=@Create
   COLOR=colors_skin
   STR={75 95}
   DEX={75 95}
   INT={25 40}
   SWORDSMANSHIP={70.0 100.0}
   FENCING={40.0 80.0}
   TACTICS={70.0 100.0}
   PARRYING={50.0 90.0}
   ANATOMY={60.0 100.0}
   HEALING={60.0 100.0}
   MAGICRESISTANCE={40.0 80.0}
   ITEMNEWBIE={ i_hair_long 3 i_hair_ponytail 3 i_hair_pageboy 2 i_hair_short 1 }
   COLOR=colors_hair
   ITEM={ i_chainmail_tunic 2 i_ringmail_tunic 2 i_leather_tunic 1 }
   ITEM=i_leather_leggings
   ITEM=i_leather_gloves
   ITEM={ i_shoes_plain 3 i_boots_thigh 2 i_sandals 2 }
   ITEM={ i_halberd 3 i_katana 3 i_mace 2 i_staff_quarter 1 }
   ITEM=i_bandage,{20 60}
   ITEM=i_potion_heal,{1 4}
   ITEM=i_potion_cure,{1 3}
   ITEM=i_gold,{80 600}

