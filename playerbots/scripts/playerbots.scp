   COLOR=colors_all
   ITEM={ i_skirt_long 2 i_skirt_short 2 i_kilt 1 }
   COLOR=colors_all
   ITEM={ i_shoes_plain 3 i_boots_thigh 2 i_sandals 2 }
   ITEM={ i_bread_loaf 3 i_cheese_wedge 2 i_muffin 2 i_chicken_leg 1 },{2 4}
   ITEM={ i_glass_of_water 2 i_glass_of_milk 1 },{1 2}
   ITEM=i_gold,{20 300}
   LOCAL.TRADE=<R1,10>
   IF (<LOCAL.TRADE> <= 4)
      TAILORING={40.0 100.0}
      ITEM=i_sewing_kit
      ITEM=i_scissors
      ITEM=i_cloth,{20 60}
   ELIF (<LOCAL.TRADE> <= 7)
      FISHING={50.0 100.0}
      COOKING={40.0 100.0}
      ITEM=i_fishing_pole
      ITEM=i_fry_pan
      ITEM=i_dagger
   ELIF (<LOCAL.TRADE> <= 9)
