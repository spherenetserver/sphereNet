<Project Sdk="Microsoft.NET.Sdk">

  <!-- Example in-process plugin (docs/PLUGINS.md). Not shipped; the tests load it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The server provides the contract assembly; a plugin must not ship its own copy. -->
    <ProjectReference Include="..\SphereNet.Plugins.Abstractions\SphereNet.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
