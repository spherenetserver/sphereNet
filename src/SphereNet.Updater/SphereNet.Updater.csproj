<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SphereNet.Updater: tek basina calisan guncelleyici / kurucu. Panelden ve
    sunucudan bagimsizdir; bilerek hicbir SphereNet projesine referans vermez ki
    tek EXE kucuk kalsin ve kurulum bozuk olsa bile calissin.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SphereNet.Updater</AssemblyName>
    <RootNamespace>SphereNet.Updater</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SphereNet.Tests" />
  </ItemGroup>

</Project>
