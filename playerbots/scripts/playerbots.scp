//----------------------------------------------------------------------------
// Townsfolk: crafters, merchants, newcomers in plain cloth
//----------------------------------------------------------------------------
[CHARDEF c_playerbot_townsfolk_m]
ID=c_man
NAME=#NAMES_HUMANMALE
CAN=MT_EQUIP|MT_USEHANDS|MT_WALK|MT_RUN|MT_MALE
CATEGORY=Player Bots
DESCRIPTION=Townsfolk (male)
ON=@Create
   COLOR=colors_skin
   STR={40 80}
   DEX={30 60}
   INT={30 60}
   BLACKSMITHING={30.0 100.0}
   TAILORING={20.0 80.0}
   MINING={30.0 100.0}
   ITEMNEWBIE={ i_hair_short 3 i_hair_long 2 i_hair_ponytail 2 i_hair_receding 1 i_hair_pageboy 1 }
   COLOR=colors_hair
   ITEMNEWBIE={ i_beard_short 2 i_goatee 2 i_mustache 2 i_beard_long 1 }
   COLOR=match_hair
   ITEM={ i_shirt_plain 4 i_shirt_fancy 2 i_doublet 2 i_tunic 2 }
   COLOR=colors_all
   ITEM={ i_pants_long 4 i_pants_short 2 i_kilt 1 }
   COLOR=colors_all
   ITEM={ i_shoes_plain 3 i_boots_thigh 2 i_sandals 2 }
   ITEM={ i_apron_half 1 i_apron_full 1 }
   ITEM=i_dagger
   ITEM=i_gold,{20 300}

