//----------------------------------------------------------------------------
// Townsfolk: tradesmen in plain cloth. Each gets ONE trade - its skills and its
// tools together - so that it can work for its living (playerbots/work.txt says
// where each trade is plied; a tool lost or worn out is bought again, see
// playerbots/shopping.txt):
//   miner and smith          pickaxe, smith's hammer
//   lumberjack and carpenter hatchet, saw
//   fisher and cook          fishing pole, frying pan
//   tailor                   sewing kit, scissors, some cloth to start on
// The dagger is everybody's: it guts a fish and is all the weapon they have.
//----------------------------------------------------------------------------
[CHARDEF c_playerbot_townsfolk_m]
ID=c_man
NAME=#NAMES_HUMANMALE
CAN=MT_EQUIP|MT_USEHANDS|MT_WALK|MT_RUN|MT_MALE
CATEGORY=Player Bots
DESCRIPTION=Townsfolk (male)
ON=@Create
   COLOR=colors_skin
   STR={50 85}
   DEX={30 60}
   INT={30 60}
   ITEMNEWBIE={ i_hair_short 3 i_hair_long 2 i_hair_ponytail 2 i_hair_receding 1 i_hair_pageboy 1 }
   COLOR=colors_hair
   ITEMNEWBIE={ i_beard_short 2 i_goatee 2 i_mustache 2 i_beard_long 1 }
   COLOR=match_hair
   ITEM={ i_shirt_plain 4 i_shirt_fancy 2 i_doublet 2 i_tunic 2 }
   COLOR=colors_all
   ITEM={ i_pants_long 4 i_pants_short 2 i_kilt 1 }
   COLOR=colors_all
   ITEM={ i_shoes_plain 3 i_boots_thigh 2 i_sandals 2 }
   ITEM={ i_apron_half 1 i_apron_full 1 }
   ITEM=i_dagger
   ITEM={ i_bread_loaf 3 i_cheese_wedge 2 i_muffin 2 i_chicken_leg 1 },{2 4}
   ITEM={ i_glass_of_water 2 i_glass_of_milk 1 },{1 2}
   ITEM=i_gold,{20 300}
   LOCAL.TRADE=<R1,10>
   IF (<LOCAL.TRADE> <= 4)
      STR={55 90}
      MINING={50.0 100.0}
      BLACKSMITHING={40.0 100.0}
      ARMSLORE={30.0 80.0}
      ITEM=i_pickaxe
      ITEM=i_hammer_smith
   ELIF (<LOCAL.TRADE> <= 7)
      LUMBERJACKING={50.0 100.0}
      CARPENTRY={40.0 100.0}
      ITEM=i_hatchet
      ITEM=i_saw
   ELIF (<LOCAL.TRADE> <= 9)
      FISHING={50.0 100.0}
      COOKING={40.0 100.0}
      ITEM=i_fishing_pole
      ITEM=i_fry_pan
   ELSE
      TAILORING={40.0 100.0}
      ITEM=i_sewing_kit
      ITEM=i_scissors
      ITEM=i_cloth,{20 60}
   ENDIF

[CHARDEF c_playerbot_townsfolk_f]
ID=c_woman
NAME=#NAMES_HUMANFEMALE
CAN=MT_EQUIP|MT_USEHANDS|MT_WALK|MT_RUN|MT_FEMALE
