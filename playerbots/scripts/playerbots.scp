//****************************************************************************
// Player bot archetypes
//
// Server-driven player characters are created from these CHARDEFs (see
// archetypes.txt for which ones and how often). ON=@Create dresses and skills
// the character exactly like a pack NPC; afterwards the engine turns it into a
// player character. Item defnames are the pack's own - edit freely, an item the
// running pack does not define is simply skipped.
//
// T2A-era kit only: plain cloth, leather/chain/plate, classic weapons.
//****************************************************************************

//----------------------------------------------------------------------------
// Warrior
//----------------------------------------------------------------------------
[CHARDEF c_playerbot_warrior_m]
ID=c_man
NAME=#NAMES_HUMANMALE
CAN=MT_EQUIP|MT_USEHANDS|MT_WALK|MT_RUN|MT_MALE
CATEGORY=Player Bots
DESCRIPTION=Warrior (male)
ON=@Create
   COLOR=colors_skin
   STR={80 100}
   DEX={70 90}
   INT={25 40}
   SWORDSMANSHIP={70.0 100.0}
   MACEFIGHTING={40.0 80.0}
   TACTICS={70.0 100.0}
   PARRYING={50.0 90.0}
   ANATOMY={60.0 100.0}
   HEALING={60.0 100.0}
   MAGICRESISTANCE={40.0 80.0}
   ITEMNEWBIE={ i_hair_short 3 i_hair_long 2 i_hair_ponytail 2 i_hair_receding 1 i_hair_pageboy 1 }
   COLOR=colors_hair
   ITEMNEWBIE={ i_beard_short 2 i_goatee 2 i_mustache 2 i_beard_long 1 }
   COLOR=match_hair
   ITEM={ i_chainmail_tunic 3 i_ringmail_tunic 3 i_platemail_chest 2 i_studded_tunic 2 i_leather_tunic 1 }
   ITEM={ i_leather_leggings 2 i_studded_leggings 2 i_chainmail_leggings 2 i_ringmail_leggings 2 i_platemail_leggings 1 }
   ITEM={ i_leather_gloves 2 i_studded_gloves 2 i_ringmail_gloves 2 i_platemail_gloves 1 }
   ITEM={ i_chainmail_coif 2 i_bascinet 2 i_helm_nose 2 i_helm_closed 1 i_platemail_helm 1 i_leather_cap 1 },1,R2
   ITEM={ i_leather_sleeves 1 i_studded_sleeves 1 i_ringmail_sleeves 1 i_platemail_arms 1 },1,R3
   ITEM={ i_leather_gorget 1 i_platemail_gorget 1 },1,R3
   ITEM={ i_cape 3 i_surcoat 2 i_sash 1 },1,R2
   COLOR=colors_all
   ITEM={ i_shoes_plain 2 i_boots_thigh 2 i_boots_calf 2 i_sandals 1 }
   // A weapon for each of its two weapon skills; it wields the one it is better with.
   ITEM={ i_mace 2 i_hammer_war 1 i_club 1 }
   ITEM={ i_katana 3 i_sword_broad 3 i_sword_long 2 i_sword_viking 2 i_scimitar 1 i_halberd 2 i_axe_battle 1 i_axe_double 1 i_bardiche 1 }
   ITEM={ i_shield_heater 2 i_shield_buckler 2 i_shield_kite_metal 2 i_shield_round_metal 1 i_shield_wood 1 },1,R2
   ITEM=i_bandage,{20 60}
   ITEM=i_potion_heal,{1 4}
   ITEM=i_potion_cure,{1 3}
   ITEM=i_potion_refresh,{1 3}
   ITEM=i_potion_strength,{1 2}
   ITEM={ i_bread_loaf 3 i_cheese_wedge 2 i_muffin 2 i_chicken_leg 1 },{2 4}
   ITEM={ i_glass_of_water 2 i_glass_of_milk 1 },{1 2}
   ITEM=i_gold,{80 600}

