   ITEM={ i_chainmail_coif 2 i_bascinet 2 i_helm_nose 2 i_helm_closed 1 i_platemail_helm 1 i_leather_cap 1 },1,R2
   ITEM={ i_leather_sleeves 1 i_studded_sleeves 1 i_ringmail_sleeves 1 i_platemail_arms 1 },1,R3
   ITEM={ i_leather_gorget 1 i_platemail_gorget 1 },1,R3
   ITEM={ i_cape 3 i_surcoat 2 i_sash 1 },1,R2
   COLOR=colors_all
