//----------------------------------------------------------------------------
// Archer
//----------------------------------------------------------------------------
[CHARDEF c_playerbot_archer_m]
ID=c_man
NAME=#NAMES_HUMANMALE
CAN=MT_EQUIP|MT_USEHANDS|MT_WALK|MT_RUN|MT_MALE
CATEGORY=Player Bots
DESCRIPTION=Archer (male)
ON=@Create
   COLOR=colors_skin
   STR={60 80}
   DEX={80 100}
   INT={30 45}
   ARCHERY={70.0 100.0}
   TACTICS={60.0 100.0}
   ANATOMY={50.0 90.0}
   HEALING={50.0 90.0}
   HIDING={30.0 70.0}
   FENCING={30.0 60.0}
   ITEMNEWBIE={ i_hair_short 3 i_hair_long 2 i_hair_ponytail 2 i_hair_receding 1 i_hair_pageboy 1 }
   COLOR=colors_hair
   ITEM={ i_leather_tunic 3 i_studded_tunic 2 }
   ITEM={ i_leather_leggings 3 i_studded_leggings 2 }
   ITEM={ i_leather_gloves 2 i_studded_gloves 1 },1,R2
   ITEM={ i_hat_floppy 2 i_hat_wide_brim 2 i_bandana 2 i_skull_cap 2 i_hat_feather 1 i_hat_tricorne 1 },1,R2
   COLOR=colors_all
   ITEM={ i_cape 2 i_sash 1 },1,R2
   COLOR=colors_all
   ITEM={ i_shoes_plain 2 i_boots_thigh 3 i_boots_calf 2 i_sandals 1 }
   // A blade for when the quiver is empty, then the bow it fights with.
   ITEM=i_dagger
   ITEM={ i_bow 4 i_bow_composite 2 i_crossbow 2 i_crossbow_heavy 1 }
   ITEM=i_arrow,{40 150}
   ITEM=i_xbolt,{40 150}
   ITEM=i_bandage,{10 40}
   ITEM=i_potion_heal,{1 3}
   ITEM=i_potion_refresh,{1 2}
   ITEM=i_potion_agility,{1 2}
   ITEM={ i_bread_loaf 3 i_cheese_wedge 2 i_muffin 2 i_chicken_leg 1 },{2 4}
   ITEM={ i_glass_of_water 2 i_glass_of_milk 1 },{1 2}
   ITEM=i_gold,{80 600}

